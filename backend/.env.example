# Copy this file to `.env` and fill in your own values. Never commit the real `.env`.

# MongoDB connection string.
# Local:   mongodb://127.0.0.1:27017
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appName>
MONGO_URL=mongodb://127.0.0.1:27017

# Database name inside the MongoDB instance.
DB_NAME=smartwaste

# Secret used to sign JWT session tokens. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string
